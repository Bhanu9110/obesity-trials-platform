{
  "name": "obesity-trials-sync",
  "version": "1.0.0",
  "description": "ClinicalTrials.gov v2 nightly sync service for the obesity trials platform",
  "type": "module",
  "bin": {
    "obesity-sync": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync": "tsx src/index.ts sync",
    "sync:full": "tsx src/index.ts sync --full",
    "backfill": "tsx src/index.ts backfill",
    "daily": "tsx src/index.ts daily",
    "retry": "tsx src/index.ts retry",
    "failures": "tsx src/index.ts failures",
    "requeue": "tsx src/index.ts requeue",
    "dismiss": "tsx src/index.ts dismiss",
    "classify": "tsx src/index.ts classify",
    "health": "tsx src/index.ts health",
    "rebuild-products": "tsx src/index.ts rebuild-products",
    "enrich-products": "tsx src/index.ts enrich-products",
    "reparse": "tsx src/index.ts reparse",
    "quality": "tsx src/index.ts quality",
    "migrate": "bash ../db/run-migrations.sh",
    "migrate:status": "bash ../db/run-migrations.sh --status",
    "scheduler": "tsx src/scheduler.ts",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
