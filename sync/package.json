{
  "name": "obesity-trials-sync",
  "version": "1.0.0",
  "description": "ClinicalTrials.gov v2 nightly sync service for the obesity trials platform",
  "type": "module",
  "bin": {
    "obesity-sync": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync": "tsx src/index.ts sync",
    "sync:full": "tsx src/index.ts sync --full",
    "backfill": "tsx src/index.ts backfill",
    "prune-nonobesity": "tsx src/index.ts prune-nonobesity",
    "rebuild-products": "tsx src/index.ts rebuild-products",
    "scheduler": "tsx src/scheduler.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
