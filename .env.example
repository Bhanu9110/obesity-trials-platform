# ---------------------------------------------------------------------------
# Copy to .env and adjust. Each service also reads these from its own env.
# ---------------------------------------------------------------------------

# Postgres connection (used by db runner, sync service, and web app)
# (docker compose publishes Postgres on host port 55432)
DATABASE_URL=postgres://postgres:postgres@localhost:55432/obesity_trials

# --- CT.gov sync service (sync/) -------------------------------------------
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
# Only this condition keyword is pulled.
# Search terms (default: obesity OR overweight OR obese OR "weight management" OR "weight loss" OR "weight reduction" OR adiposity)
# CTGOV_CONDITION=obesity
CTGOV_PAGE_SIZE=1000
# Leave EMPTY to include ALL statuses (full history since 2000). Set a
# comma-separated list to restrict, e.g. RECRUITING,ACTIVE_NOT_RECRUITING.
CTGOV_STATUSES=
# Corpus floor: only trials whose StartDate is on/after this date.
CTGOV_START_DATE_FROM=2000-01-01
# Restrict to trials containing at least one of these intervention types.
# Empty => all study types. "DRUG" => drug/capsule studies only (excludes
# exercise/behavioral/device/procedure-only). Can list several:
# e.g. DRUG,DIETARY_SUPPLEMENT,BIOLOGICAL
CTGOV_INTERVENTION_TYPES=DRUG,BIOLOGICAL,COMBINATION_PRODUCT
# Incremental window (days) for the daily sync.
CTGOV_INCREMENTAL_DAYS=1
CTGOV_REQUEST_DELAY_MS=250
CTGOV_MAX_RETRIES=4
# Fields requested from CT.gov (only what is stored). Empty => full records.
CTGOV_FIELDS=NCTId,BriefTitle,LastUpdatePostDate,Phase,LeadSponsorName,LeadSponsorClass,Condition,InterventionType,InterventionName,LocationCountry
# Trials are stored with an obesity class (primary / comorbidity / weight_related /
# unrelated); the website shows primary-obesity trials by default. Nothing is deleted.

# --- Reliability -------------------------------------------------------------
# Failed records are retried on later runs; after this many failures in a row
# they move to the dead-letter queue (Admin page).
SYNC_MAX_ATTEMPTS=5
# A full download refuses to remove more than max(50, 20%) of stored trials
# (protects against a truncated CT.gov response). Set true once to allow it.
SYNC_ALLOW_LARGE_PRUNE=false

# --- Daily scheduler (sync/ scheduler) -------------------------------------
# Cron for the automatic update. Default midnight every day.
SYNC_CRON=0 0 * * *
# Timezone the cron runs in (IANA name). e.g. Asia/Kolkata, America/New_York.
SYNC_TZ=Asia/Kolkata
# On first boot with an empty database, run a full backfill (year 2000+).
SYNC_BACKFILL_ON_START=true

# --- Web app (web/) --------------------------------------------------------
# Only needed if the /api/sync admin trigger is used.
ADMIN_TOKEN=change-me
